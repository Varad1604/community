# ============================================================
# Green Acres / Society OS — Environment Configuration Example
# ============================================================

# Database Connections
# DATABASE_URL: Owner connection used for migrations, seeds, and maintenance
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# APP_DATABASE_URL: Unprivileged connection used by application runtime (RLS-enforced)
APP_DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Authentication & Sessions
# 32+ character high-entropy secret for signing session JWTs
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-character-secret-in-prod"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-character-secret-in-prod"

# OTP Configuration
# Provider: mock | msg91 | twilio
OTP_PROVIDER="mock"
# Set to true only in development/test
MOCK_OTP_ENABLED="true"
# MSG91 Provider credentials (when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=""

# Payments Configuration
# Gateway: mock | razorpay
PAYMENT_GATEWAY="mock"
# Razorpay API Credentials (when PAYMENT_GATEWAY=razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Runtime Environment
NODE_ENV="development"
PORT=4000
